<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Lets the tool run on a newer runtime when net10.0 is not installed. -->
    <RollForward>Major</RollForward>

    <!-- Installed as a .NET tool: `dotnet tool install CrapSharp`, then `dotnet crapsharp` (or `crapsharp` for a global tool). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>crapsharp</ToolCommandName>
    <PackageId>CrapSharp</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Title>CrapSharp</Title>
    <Authors>Nicolas Friederich</Authors>
    <Copyright>Copyright (c) 2026 Nicolas Friederich</Copyright>
    <Description>Per-method CRAP score and quality gate for C# projects. Runs tests with coverage and reports risky methods in the terminal, CI and AI-assisted workflows.</Description>
    <PackageTags>csharp;dotnet;dotnet-tool;code-quality;crap;cyclomatic-complexity;code-coverage;ci;tdd</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Telperien/CrapSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Telperien/CrapSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReleaseNotes>Initial preview: per-method CRAP gate, Cobertura coverage (VSTest and Microsoft.Testing.Platform), --changed and --changed-since selection, --filter and --exclude, JSON output.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
