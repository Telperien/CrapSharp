<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Lets the tool run on a newer runtime when net10.0 is not installed. -->
    <RollForward>Major</RollForward>

    <!-- Installed as a .NET tool: `dotnet tool install CrapSharp`, then `dotnet crapsharp` (or `crapsharp` for a global tool). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>crapsharp</ToolCommandName>
    <PackageId>CrapSharp</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Description>Per-method CRAP score (complexity and coverage) for C#, usable as a strict gate in a terminal or in CI.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
